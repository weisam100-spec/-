# Copy to .env.local for `npm run dev`, and set the same values as
# environment variables in your Vercel (or other host) project settings
# for production. See README.md for the full setup walkthrough.

# ---- App ----
# Public URL this app is deployed at. Required in production so ECPay's
# ReturnURL (server-to-server webhook) and ClientBackURL are correct
# absolute URLs. Falls back to the request's own origin in dev.
APP_URL=http://localhost:3000

# Price (in TWD) charged to unlock a full report.
REPORT_PRICE_TWD=299
NEXT_PUBLIC_REPORT_PRICE_TWD=299

# ---- Supabase (production data store) ----
# Create a project at https://supabase.com, run supabase/migrations/0001_init.sql
# in its SQL editor, then fill these in from Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY is secret — server-side only, never expose to
# the browser (there is no NEXT_PUBLIC_ variant of it on purpose).
# Leave both unset to use the local-disk FileStore instead (dev only —
# see the warning in lib/store.ts about why that's not viable in prod).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- ECPay (綠界) payment gateway ----
# Defaults below are ECPay's own published SANDBOX test 特店 credentials —
# safe to commit, and enough to exercise the full checkout flow against
# https://payment-stage.ecpay.com.tw without a real merchant account.
# Before accepting real money: apply for a 特店 account at ecpay.com.tw
# (needs a registered business + 統一編號), replace the three values
# below with your real ones, and set ECPAY_MODE=Production.
ECPAY_MODE=Test
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS
