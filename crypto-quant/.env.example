# ============================================================
# 加密貨幣量化策略分析網站 - 環境變數範例
# 複製此檔為 .env.local 後依需求調整，切勿把 .env.local 提交到版控
# ============================================================

# 資料來源模式：binance（正式，連線 Binance 公開市場 API） | demo（本機示範用模擬資料，會於介面標示 DEMO）
DATA_PROVIDER=binance

# Binance 公開市場資料端點（現貨），一般不需更改
BINANCE_BASE_URL=https://api.binance.com

# 若日後串接需要 API Key 的資料來源（例如 CoinMarketCap），請在此設定，程式碼中絕不可寫死金鑰
# COINMARKETCAP_API_KEY=
# COINGECKO_API_KEY=

# USDT/新臺幣匯率資料來源模式：fixed（使用下方固定備援匯率） | external（未來串接匯率 API）
FX_PROVIDER=fixed
FX_USDT_TWD_FALLBACK=32.5

# 資料庫檔案位置（SQLite，本機/展示用）。未來可改接 PostgreSQL，僅需替換 lib/storage 內的 repository 實作
DATABASE_FILE=./data/app.db

# 行情/K 線快取存活時間（秒）
CACHE_TTL_TICKER_SECONDS=15
CACHE_TTL_KLINES_SECONDS=60

# 對外部資料來源的重試設定（指數退避，禁止無限重試）
FETCH_MAX_RETRIES=3
FETCH_RETRY_BASE_MS=500

# API 速率限制（每個 IP 每分鐘可呼叫次數）
RATE_LIMIT_PER_MINUTE=60

# 回測安全限制：單次回測最大 K 棒數與逾時時間，避免站點失去回應
BACKTEST_MAX_BARS=20000
BACKTEST_TIMEOUT_MS=15000

# 是否啟用「真實交易」功能（第一版必須為 false，UI 會顯示尚未開放）
ENABLE_LIVE_TRADING=false

# 應用程式所在時區（顯示用，計算一律以 UTC 儲存）
APP_TIMEZONE=Asia/Taipei
